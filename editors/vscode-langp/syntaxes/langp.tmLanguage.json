{
  "name": "Lang.P",
  "scopeName": "source.langp",
  "fileTypes": ["lp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-compound" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#input-types" },
    { "include": "#keywords-operator" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#block-delimiters" },
    { "include": "#operators" },
    { "include": "#function-def" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line",
          "match": "@.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords-compound": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(otherwise if|repeat forever|wait for)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|otherwise|else|repeat|forever|for|while|try|catch|finally|break|continue|return|on|match|await|async|times|end)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration",
          "match": "\\b(function|type|enum|interface|use|let|static)\\b"
        }
      ]
    },
    "input-types": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "(?<=\\binput\\s)(text|number|decimal|boolean|password)\\b"
        }
      ]
    },
    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "\\b(and|or|not|in|with|as|is|range)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(true|false|null|self|super|this|pass)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function",
          "match": "\\b(print|input|len|to_string|assert|read|read_bytes|read_lines)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type",
          "match": "\\b(String|Int|Float|Bool|List|Dict|Void|Any|Object|Char)\\b"
        },
        {
          "name": "entity.name.type",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "block-delimiters": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.terminator",
          "match": "(?<=\\S)\\.(?!\\.)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator",
          "match": "->|=>|\\+\\+|\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\%\\=|\\=\\=|\\!\\=|\\*\\*|//|\\?\\?|,|:|\\+|\\-|\\*|\\/|\\%|\\=|\\<|\\>|\\!"
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "name": "entity.name.function",
          "match": "(?<=\\bfunction\\s+)\\w+"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function",
          "match": "\\b\\w+(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
