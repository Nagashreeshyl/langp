{
  "name": "langp",
  "displayName": "Lang.P",
  "description": "Lang.P — syntax colors, error underlines, autocomplete, auto-indent",
  "version": "0.2.0",
  "publisher": "Nagashreeshyl",
  "license": "MIT",
  "icon": "icons/langp.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nagashreeshyl/langp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["langp", "lang.p", "lang", "lp"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "langp",
        "aliases": ["Lang.P", "LangP", "langp"],
        "extensions": [".lp"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/langp.svg",
          "dark": "./icons/langp.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "langp",
        "scopeName": "source.langp",
        "path": "./syntaxes/langp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "langp",
        "path": "./snippets/langp.json"
      }
    ],
    "commands": [
      {
        "command": "langp.runFile",
        "title": "Lang.P: Run current file"
      }
    ],
    "configuration": {
      "title": "Lang.P",
      "properties": {
        "langp.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to lang-lsp (auto-detected if empty)"
        },
        "langp.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable lang-lsp for autocomplete"
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.lp": "langp"
      },
      "[langp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.autoIndent": "full",
        "editor.renderValidationDecorations": "on",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggest.showSnippets": true
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
